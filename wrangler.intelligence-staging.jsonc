{
  // INTELLIGENCE-only staging Worker.
  // DO NOT DEPLOY until database_id is replaced with the verified ID of
  // mehran-msh-intelligence-staging and all required staging migrations through 0019 are applied there.
  // CI uses disposable SQLite/D1 databases only; it does not verify or migrate the remote staging database.
  // This config must never be used with the production database.
  "name": "mehran-intelligence-staging",
  "main": "intelligence-staging-worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mehran-msh-intelligence-staging",
      "database_id": "REPLACE_WITH_VERIFIED_STAGING_DATABASE_ID"
    }
  ]
}
